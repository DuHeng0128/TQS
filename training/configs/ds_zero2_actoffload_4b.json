{
  "_comment": "DeepSpeed ZeRO-2 + activation CPU offload for Qwen3-4B on 8×A800 (80GB).",
  "_note": "Activation offload moves layer activations to CPU during forward, freeing ~12 GB GPU memory at 64K context. HF gradient_checkpointing handles recompute; DeepSpeed activation_checkpointing only controls offload, not recompute.",

  "bf16": {
    "enabled": true
  },

  "zero_optimization": {
    "stage": 2,
    "overlap_comm": true,
    "contiguous_gradients": true,
    "reduce_bucket_size": 2e8,
    "reduce_scatter": true,
    "allgather_partitions": true,
    "allgather_bucket_size": 2e8
  },

  "gradient_accumulation_steps": "auto",
  "gradient_clipping": "auto",
  "steps_per_print": 10,

  "train_batch_size": "auto",
  "train_micro_batch_size_per_gpu": "auto",

  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": "auto",
      "betas": "auto",
      "eps": "auto",
      "weight_decay": "auto"
    }
  },

  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_min_lr": 0,
      "warmup_max_lr": "auto",
      "warmup_num_steps": "auto",
      "total_num_steps": "auto"
    }
  },

  "wall_clock_breakdown": false
}
