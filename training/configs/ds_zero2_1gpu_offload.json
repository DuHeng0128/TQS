{
  "_comment": "DeepSpeed ZeRO-2 + optimizer CPU offload — for single-GPU profiling/debugging.",
  "_note": "Offloading optimizer states to CPU frees ~48 GB of GPU memory. Use this config only for 1-GPU runs; for 8-GPU production use ds_zero2_4b.json (no offload, faster).",

  "bf16": {
    "enabled": true
  },

  "zero_optimization": {
    "stage": 2,
    "overlap_comm": true,
    "contiguous_gradients": true,
    "reduce_bucket_size": 5e8,
    "reduce_scatter": true,
    "allgather_partitions": true,
    "allgather_bucket_size": 5e8,
    "offload_optimizer": {
      "device": "cpu",
      "pin_memory": true
    }
  },

  "gradient_accumulation_steps": "auto",
  "gradient_clipping": "auto",
  "steps_per_print": 1,

  "train_batch_size": "auto",
  "train_micro_batch_size_per_gpu": "auto",

  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": "auto",
      "betas": "auto",
      "eps": "auto",
      "weight_decay": "auto"
    }
  },

  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_min_lr": 0,
      "warmup_max_lr": "auto",
      "warmup_num_steps": "auto",
      "total_num_steps": "auto"
    }
  },

  "wall_clock_breakdown": false
}
